# BasicMails environment template
#
# Server-only. Set this in Vercel Project Settings > Environment Variables.
# Use a random password with at least 16 characters. Do not use NEXT_PUBLIC_.
DEMO_PASSWORD=

# Server-only proxycheck.io private API key. Never use NEXT_PUBLIC_.
PROXYCHECK_API_KEY=

# Waiting list: private server-side values, set in Vercel and redeploy.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. Basic Mails <hello@basicmails.de>
RESEND_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
